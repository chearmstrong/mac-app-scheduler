<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.mac-app-scheduler.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/mac-app-scheduler/venv/bin/mac-app-scheduler</string>
    <string>daemon</string>
  </array>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Umask</key>
  <integer>18</integer>
  <key>StandardOutPath</key>
  <string>/var/log/mac-app-scheduler.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/mac-app-scheduler.log</string>
</dict>
</plist>
